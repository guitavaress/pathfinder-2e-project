# Copy to .env and adjust if needed. .env is gitignored.
# The LLM server's OpenAI-compatible base URL (llama.cpp's llama-server, or any
# OpenAI-compatible local server — LM Studio, Ollama...).
# Start llama-server with --jinja (required for tool calling, which the rules
# stage depends on). See the README for the full command.
# Prefer 127.0.0.1 over localhost: on WSL2 `localhost` resolves to IPv6 ::1
# first, and llama-server binds IPv4 only unless told otherwise.
LLM_BASE_URL=http://127.0.0.1:1234/v1

# GM model. By default ONE model drives both stages (rules + narrative), each
# with its own context (system prompt + thread). This keeps a single model
# resident in VRAM — no per-turn weight swap.
# llama.cpp serves whatever GGUF you loaded and ignores this field on requests;
# it is used by the /health check, which substring-matches it against the id
# reported by GET /v1/models. Set it to a recognizable fragment of that id.
GM_MODEL=gemma-4-12b-it

# Optional: split the two stages across two models (specialization at the cost of
# VRAM). llama.cpp serves ONE model per server, so this needs a second server and
# is not reachable through a single base URL. Unset = both stages use GM_MODEL.
# RULES_MODEL=gemma-4-12b-it
# NARRATIVE_MODEL=gemma-4-12b-it

# GM backend port (optional, default 3001)
PORT=3001
