# Copy to .env and adjust if needed. .env is gitignored.
# LM Studio's OpenAI-compatible base URL (default: local install on port 1234).
# Start the server with: lms server start
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# GM model. By default ONE model drives both stages (rules + narrative), each
# with its own context (system prompt + thread). This keeps a single model
# resident in VRAM — no per-turn weight swap. Use the model KEY exactly as
# LM Studio reports it (see `lms ls` or GET /v1/models); it must be downloaded
# (`lms get <model>`). Default: Gemma 4 12B (official, Q4) — fits ~12 GB VRAM and
# follows instructions well. After downloading, confirm the exact key with
# `lms ls` and adjust if it differs.
GM_MODEL=google/gemma-4-12b

# Optional: split the two stages across two models (specialization at the cost
# of VRAM). If BOTH are set to different models and don't fit together, LM Studio
# swaps weights each turn (minutes/turn on ~12 GB). Unset = both use GM_MODEL.
# RULES_MODEL=google/gemma-4-12b
# NARRATIVE_MODEL=google/gemma-3-27b

# GM backend port (optional, default 3001)
PORT=3001

# --- Scene illustration (optional feature) ---------------------------------
# On-demand scene images from GM narration: a button in the chat distills the
# narration into a visual prompt (GM_MODEL) and renders it with Z-Image Turbo
# via a local ComfyUI. Start ComfyUI with: npm run comfy
# ComfyUI API base URL (default: local install on port 8188).
# COMFYUI_URL=http://127.0.0.1:8188
# Set to 1 to disable the feature entirely (button hidden/503).
# SCENE_IMAGE_DISABLED=1
# Where generated PNGs are stored (default: <repo root>/scene-images, gitignored).
# SCENE_IMAGE_PATH=/absolute/path/to/scene-images
# Optional LoRAs applied to the image model: comma-separated name:strength.
# Files must live in ComfyUI/models/loras. Example:
# SCENE_IMAGE_LORAS=dark-fantasy-style.safetensors:0.8,character-jao.safetensors:0.6
# Path to LM Studio's CLI, used to free VRAM around each generation (unload the
# GM model, generate, reload). If missing, generation proceeds without the swap.
# WSL default: /mnt/c/Users/<user>/.lmstudio/bin/lms.exe
# LMS_EXE=/mnt/c/Users/gui_t/.lmstudio/bin/lms.exe
